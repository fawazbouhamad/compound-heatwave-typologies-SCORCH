# Text files are stored with LF line endings; the scripts also write LF, so
# catalog checksums are the same on every operating system.
* text=auto eol=lf
*.py text eol=lf
*.R text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cff text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.gif binary
*.pdf binary
*.nc binary
*.rds binary
*.shp binary
*.shx binary
*.dbf binary
*.prj binary
*.cpg binary
*.ttf binary
*.pptx binary

